# PayTrack API configuration
PORT=4000
DATABASE_URL=postgres://paytrack:paytrack@localhost:5432/paytrack
# REQUIRED in production: long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed web origins (mobile apps don't send Origin)
CORS_ORIGINS=
# Set when running behind a reverse proxy / load balancer (for rate limiting by client IP)
TRUST_PROXY=1
NODE_ENV=development
