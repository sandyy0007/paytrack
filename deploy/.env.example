# PayTrack Production Server Environment Configuration

# 1. Your domain or public IP (e.g. api.paytrack.yourdomain.com or 123.45.67.89)
# If using a domain pointing to your VPS, Caddy automatically acquires a free Let's Encrypt SSL certificate!
# If using an IP or testing without domain, set DOMAIN=:80
DOMAIN=api.example.com

# 2. PostgreSQL Configuration
POSTGRES_DB=paytrack
POSTGRES_USER=paytrack_admin
POSTGRES_PASSWORD=replace_with_strong_password_abc123xyz!

# 3. JWT Security Secret (Must be >= 32 characters, secure random string)
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_random_99182374

# 4. Token Expirations
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
